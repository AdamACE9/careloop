<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose owns all real styling (see ui/theme/Theme.kt).
        These XML themes exist only so the system has something to draw during cold start,
        before Compose takes over. Matching the navy here prevents the white flash that
        otherwise appears on launch.
    -->
    <style name="Theme.CareLoop" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/careloop_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        Incoming-call variant. Fullscreen and non-translucent: the call must own the whole
        display when it arrives over the lock screen, with nothing showing through behind it.
    -->
    <style name="Theme.CareLoop.Call" parent="Theme.CareLoop">
        <item name="android:windowBackground">@color/careloop_navy_deep</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
        The launch theme.

        The system draws this before any of our code runs, so it is the first
        thing anyone ever sees of CareLoop. It shows the Loop on navy, which is
        the same mark that then breathes on the call screen, so the app opens
        with its own identity rather than a white rectangle.

        postSplashScreenTheme is what the activity switches to once Compose is
        ready. Without it the splash background would stay behind the whole app.
    -->
    <style name="Theme.CareLoop.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/careloop_navy_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CareLoop</item>
    </style>
</resources>
