# Non-secret deploy parameters for Cloud Functions.
#
# These are model identifiers, not credentials, and they are committed on
# purpose: without them `firebase deploy --non-interactive` stops and asks for a
# value for every defineString parameter, even ones that declare a default. A
# deploy that only works when a human is watching is not a deploy you can
# automate or repeat.
#
# SECRETS DO NOT GO IN THIS FILE. GEMINI_API_KEY and OPENFDA_API_KEY are held in
# Google Secret Manager via `firebase functions:secrets:set`, which is why they
# are absent here. Anything added below is readable by anyone with the repo.

# Live model IDs carry preview suffixes and get renamed. Verify before a demo:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TEXT_MODEL=gemini-2.5-flash
